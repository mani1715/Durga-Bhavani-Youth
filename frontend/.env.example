# ==============================================================================
# Garuvupalem Dasara Frontend Environment Configuration
# Location: frontend/.env
# ==============================================================================

# Backend API URL (Optional in development or when reverse-proxied by server.mjs)
# In production on Railway:
# Set this to the public URL of your Railway backend service (e.g. https://garuvupalem-backend.up.railway.app)
# NOTE: In Vite, variables exposed to the client bundle MUST be prefixed with VITE_
VITE_API_URL=https://your-backend-service.up.railway.app

# Optional server-side proxy target (used by server.mjs in production to proxy /api)
# BACKEND_URL=https://your-backend-service.up.railway.app

# Port for local production testing (automatically assigned by Railway as $PORT)
PORT=3000
