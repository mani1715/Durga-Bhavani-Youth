# ==============================================================================
# Garuvupalem Dasara Backend Environment Configuration
# Location: backend/.env
# NOTE: Do NOT commit .env to version control. Keep all credentials private.
# ==============================================================================

# Project Name
PROJECT_NAME="Festival & Donation Management SaaS Platform"

# Supabase PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If password contains special characters like '@', ensure they are URL-encoded (e.g., '@' -> '%40')
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend-only Service Role Secret for server-side Storage administration
SUPABASE_STORAGE_SECRET=your-supabase-service-role-secret-key-here

# Supabase Storage Buckets
SUPABASE_PUBLIC_BUCKET=festival-public
SUPABASE_PRIVATE_BUCKET=festival-private

# Application Storage Backend ("supabase", "s3", or "local")
STORAGE_TYPE=supabase
LOCAL_STORAGE_DIR=storage

# JWT Security
JWT_SECRET=generate-a-secure-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://garuvupalem-dasara.org
